APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://fin:fin@localhost:5433/fin?sslmode=disable

PUBLIC_URL=http://localhost:5173
STATIC_DIR=

COOKIE_DOMAIN=
COOKIE_SECURE=true
SESSION_TTL=720h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32 | pbcopy
SECRET_KEY=

SYNC_CRON="0 */6 * * *"
SYNC_COOLDOWN=10m
PLAID_COUNTRY_CODES=US

MCP_ENABLED=true
MCP_ACCESS_TOKEN_TTL=1h
MCP_REFRESH_TOKEN_TTL=720h
MCP_GRANT_MAX_AGE=2160h
MCP_ALLOWED_ORIGINS=

VERSION=
