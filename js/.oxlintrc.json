{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "promise",
    "oxc"
  ],
  "jsPlugins": [
    "./lint/fin-plugin.ts",
    {
      "name": "react-hooks-js",
      "specifier": "eslint-plugin-react-hooks"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error"
  },
  "ignorePatterns": ["src/lib/api/schema.gen.ts"],
  "rules": {
    "fin/alias-imports": "error",
    "fin/no-comments": "error",
    "fin/route-private-imports": "error",
    "fin/no-effects-outside-hooks": "error",
    "fin/max-one-use-state": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@/lib/api/client",
            "message": "Use a hook from @/lib/queries."
          },
          {
            "name": "openapi-react-query",
            "message": "Use a hook from @/lib/queries."
          },
          {
            "name": "openapi-fetch",
            "message": "Use a hook from @/lib/queries."
          },
          {
            "name": "@tanstack/react-query",
            "importNames": [
              "useQuery",
              "useMutation",
              "useInfiniteQuery",
              "useSuspenseQuery",
              "useQueryClient"
            ],
            "message": "Use a hook from @/lib/queries."
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-condition": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/static-components": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "eqeqeq": "error",
    "no-console": "error",
    "react/react-in-jsx-scope": "off",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-handler-names": "off",
    "react/hook-use-state": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "func-style": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "no-ternary": "off",
    "no-magic-numbers": "off",
    "one-var": "off",
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true
      }
    ],
    "max-statements": [
      "error",
      {
        "max": 15
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "import/group-exports": "off",
    "import/exports-last": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "@tanstack/router-core",
            "name": "Redirect"
          }
        ]
      }
    ],
    "unicorn/no-null": "off",
    "promise/prefer-await-to-then": "off",
    "no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/app/**/*.Page.tsx"],
      "rules": {
        "unicorn/filename-case": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "import/no-namespace": "off",
        "react/function-component-definition": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
