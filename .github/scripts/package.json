{
  "name": "scripts",
  "version": "1.0.0",
  "private": true,
  "description": "tahminator/fin CI Scripts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun run fmt && bun run lint",
    "fix": "bun run lint:fix && bun run fmt:fix",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write ."
  },
  "dependencies": {
    "@tahminator/pipeline": "^1.0.106",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  }
}
